# ============================================
# Lableit - Railway Environment Variables
# ============================================
# Copy this file and configure your Railway project environment variables
# Railway supports variable references like ${{ServiceName.VARIABLE}}

# ============================================
# API Service Environment Variables
# ============================================

# Port is automatically set by Railway
# PORT (automatically set by Railway)

# API Host (use 0.0.0.0 for Railway)
API_HOST=0.0.0.0

# Logging level (info, debug, warn, error)
LOG_LEVEL=info

# Database - Use Railway's PostgreSQL plugin
# The DATABASE_URL is automatically provided by the PostgreSQL plugin
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Redis - Use Railway's Redis plugin
# The REDIS_URL is automatically provided by the Redis plugin
REDIS_URL=${{Redis.REDIS_URL}}

# S3-Compatible Storage (Choose one option)
# Option 1: AWS S3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-aws-access-key
# S3_SECRET_KEY=your-aws-secret-key
# S3_BUCKET=lableit-assets

# Option 2: Cloudflare R2 (Recommended - cheaper egress)
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=your-r2-access-key
# S3_SECRET_KEY=your-r2-secret-key
# S3_BUCKET=lableit-assets

# Option 3: Backblaze B2
# S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# S3_REGION=us-west-002
# S3_ACCESS_KEY=your-b2-key-id
# S3_SECRET_KEY=your-b2-application-key
# S3_BUCKET=lableit-assets

# Authentication - Clerk
# Get your keys from https://dashboard.clerk.dev
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY

# JWT Secret - Generate a secure random string
JWT_SECRET=change-this-to-a-secure-random-string

# Access control (API + worker)
# REQUIRED, no default: email of the account that approves access requests.
# If unset, nobody can approve new users.
ADMIN_EMAIL=admin@example.com
# Optional: email the admin when someone requests access. Without it, requests
# still show on /admin. RESEND_FROM must use a domain verified in Resend.
# RESEND_API_KEY=re_YOUR_RESEND_API_KEY
# RESEND_FROM=Lableit <access@your-domain.com>
# API CORS allow-list, comma-separated with no spaces. Only needed when the
# browser calls the API from a different origin (the web /api proxy is same-origin).
# ALLOWED_ORIGINS=https://app.your-domain.com

# Inference Service URL - Use Railway's private networking
# Format: http://SERVICE_NAME.railway.internal:PORT
# Railway internal services listen on :8080 (the platform routes the public
# $PORT to 8080 internally), so address other services on :8080.
INFERENCE_URL=http://inference.railway.internal:8080
INFERENCE_TIMEOUT_MS=60000
INFERENCE_BATCH_TIMEOUT_MS=300000
INFERENCE_MAX_RETRIES=3

# Process roles
# API service:    WORKER_MODE=false RUN_HTTP_SERVER=true
# Worker service: WORKER_MODE=true  RUN_HTTP_SERVER=false
WORKER_MODE=false
RUN_HTTP_SERVER=true

# FFmpeg path (pre-installed in container)
FFMPEG_PATH=ffmpeg

# Node environment
NODE_ENV=production

# ============================================
# Web Frontend Environment Variables
# ============================================

# Railway environment indicator
RAILWAY_ENVIRONMENT=production

# API URL for nginx proxy (Railway internal networking)
# Railway internal services listen on :8080.
API_URL=http://api.railway.internal:8080

# Clerk Publishable Key (frontend)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY

# API base URL for frontend (use /api for proxy, or full URL)
VITE_API_URL=/api

# ============================================
# Inference Service Environment Variables
# ============================================

# Preload the SAM3 model on startup
PRELOAD_MODEL=true

# Model cache directory
MODEL_CACHE_DIR=/app/models

# Unbuffered Python output for logs
PYTHONUNBUFFERED=1

# HuggingFace token. facebook/sam3 is a gated model: request access on its
# model page, then use a token from the approved account.
# HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN

# ============================================
# Railway-Specific Notes
# ============================================
#
# 1. PostgreSQL Plugin:
#    - Add from Railway dashboard: + New > PostgreSQL
#    - DATABASE_URL is automatically injected
#
# 2. Redis Plugin:
#    - Add from Railway dashboard: + New > Redis
#    - REDIS_URL is automatically injected
#
# 3. Private Networking:
#    - Services communicate via: http://SERVICE_NAME.railway.internal:PORT
#    - Use this for API-to-Inference communication
#
# 4. Public Networking:
#    - Configure custom domain in Railway dashboard
#    - Railway provides free SSL certificates
#
# 5. Volumes:
#    - Railway supports persistent volumes for model storage
#    - Configure in service settings: Settings > Mount > Add Volume
#
# 6. GPU Support:
#    - Railway does not currently support GPUs
#    - The inference service will run in CPU mode
#    - Consider using a dedicated GPU service (RunPod, Modal) for inference
