# Production Environment Variables
# Template only. Never commit real values.
# Copy this file to .env and update with your actual values

# API / Worker
PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Database
POSTGRES_USER=lableit
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=lableit
DATABASE_URL=postgresql://lableit:CHANGE_ME_SECURE_PASSWORD@postgres:5432/lableit

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3
# The API returns presigned URLs built from S3_ENDPOINT, so users' browsers must
# be able to reach it. http://minio:9000 only works inside Docker; in production
# use a public MinIO host behind TLS, or S3 / R2.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET=lableit

# Auth
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARS

# Clerk (https://dashboard.clerk.com)
# Frontend publishable key (baked/injected into the web app) and backend secret.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_CHANGE_ME_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_live_CHANGE_ME_CLERK_SECRET_KEY

# Access control (API + worker)
# REQUIRED, no default: email of the account that approves access requests.
# If unset, nobody can approve new users.
ADMIN_EMAIL=CHANGE_ME_admin@example.com
# Optional: email the admin when someone requests access. Without it, requests
# still show on /admin. RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
# API CORS allow-list, comma-separated with no spaces. Only needed when the
# browser calls the API from a different origin (unset is fine behind /api proxy).
ALLOWED_ORIGINS=

# Inference service
INFERENCE_URL=http://inference:8001
INFERENCE_TIMEOUT_MS=60000
INFERENCE_BATCH_TIMEOUT_MS=300000
INFERENCE_MAX_RETRIES=3
# Inference: facebook/sam3 is a gated Hugging Face model. Request access on its
# model page, then use a token from the approved account.
HF_TOKEN=

# Process roles
# API service:    WORKER_MODE=false RUN_HTTP_SERVER=true
# Worker service: WORKER_MODE=true  RUN_HTTP_SERVER=false
WORKER_MODE=false
RUN_HTTP_SERVER=true

# Video processing
FFMPEG_PATH=ffmpeg

# Node environment
NODE_ENV=production
