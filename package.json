{
  "name": "lableit",
  "private": true,
  "version": "0.0.1",
  "description": "SAM3-powered vision annotation platform for images and videos.",
  "author": "Mohammed Sabek",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && bun run dev",
    "dev:inference": "cd apps/inference && uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "dev:web": "cd apps/web && bun run dev",
    "lint": "bun run --workspaces lint"
  },
  "devDependencies": {
    "prisma": "5.19.1"
  },
  "dependencies": {
    "@prisma/client": "5.19.1"
  },
  "overrides": {
    "follow-redirects": "1.16.0"
  }
}
