# ============================================
# Lableit API / Worker — environment variables
# ============================================
# Copy to apps/api/.env and fill in real values. NEVER commit a real .env.
# All values below are placeholders / documentation only.

# --- Database (Prisma / PostgreSQL) ---
# Local dev uses port 5433 (see infra/docker-compose.yml).
DATABASE_URL=postgresql://lableit:lableit@localhost:5433/lableit

# --- Redis (BullMQ queue + caches) ---
# Local dev uses port 6380.
REDIS_URL=redis://localhost:6380

# --- Inference service ---
# Local dev: http://localhost:8001  | Railway internal: http://inference.railway.internal:8080
INFERENCE_URL=http://localhost:8001
INFERENCE_TIMEOUT_MS=60000
INFERENCE_BATCH_TIMEOUT_MS=300000
INFERENCE_MAX_RETRIES=3
# CORS allow-list for the inference service (comma-separated origins).
INFERENCE_ALLOWED_ORIGINS=
# Shared secret checked by the inference service (X-Inference-Secret header).
# The API does not send this header yet, so leave it unset here and keep the
# inference service on a private network instead.
INFERENCE_SHARED_SECRET=

# --- S3 / object storage (MinIO locally, R2/S3/B2 in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lableit

# --- Auth ---
# JWT signing secret — generate a long random string (>= 32 chars).
JWT_SECRET=
# Clerk backend secret key (https://dashboard.clerk.com).
CLERK_SECRET_KEY=
# REQUIRED, no default: email of the account that approves access requests.
# If unset, nobody can approve new users.
ADMIN_EMAIL=
# Optional: email the admin when someone requests access (https://resend.com).
# Without it, requests still show on /admin.
RESEND_API_KEY=
RESEND_FROM=

# --- HTTP server ---
PORT=3001
API_HOST=0.0.0.0
# CORS allow-list for the API in production (comma-separated origins, no spaces).
# Unset in production = no cross-origin access (fine behind the web /api proxy).
ALLOWED_ORIGINS=

# --- Process roles ---
# API service:    WORKER_MODE=false RUN_HTTP_SERVER=true
# Worker service: WORKER_MODE=true  RUN_HTTP_SERVER=false
WORKER_MODE=false
RUN_HTTP_SERVER=true
# Local dev convenience: embed a worker inside the API process (set false to disable).
RUN_WORKER=true

# --- Runtime ---
LOG_LEVEL=info
NODE_ENV=development

# --- Video processing ---
FFMPEG_PATH=ffmpeg
