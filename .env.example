# API / Worker
PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# Database (using port 5433 to avoid conflicts with local PostgreSQL on Windows)
DATABASE_URL=postgresql://lableit:lableit@localhost:5433/lableit

# Redis (using port 6380 to avoid conflicts with local Redis on Windows)
REDIS_URL=redis://localhost:6380

# Clerk Authentication (https://clerk.com)
# Get your keys from: https://dashboard.clerk.com/last-active?path=api-keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lableit

# Auth
JWT_SECRET=change-me-to-a-secure-random-string

# Inference service
INFERENCE_URL=http://localhost:8001
INFERENCE_TIMEOUT_MS=60000
INFERENCE_BATCH_TIMEOUT_MS=300000
INFERENCE_MAX_RETRIES=3

# Process roles
# Local dev embeds a worker in the API process unless RUN_WORKER=false.
RUN_WORKER=true
RUN_HTTP_SERVER=true

# Video processing
FFMPEG_PATH=ffmpeg

# Optional: HuggingFace token for model downloads
# HF_TOKEN=hf_YOUR_TOKEN_HERE
