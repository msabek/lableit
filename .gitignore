apps/inference/models/

# Inference runtime config + settings (generated at first model download; may contain absolute paths)
apps/inference/model_config.json
apps/inference/settings.json
!apps/inference/model_config.example.json

# Export / temp files (generated during runtime) — keep the dirs, ignore contents
apps/api/exports/*
!apps/api/exports/.gitkeep
apps/api/temp/*
!apps/api/temp/.gitkeep

# Dev tooling / local agent artifacts (not part of the published project)
.claude/
.remember/
.playwright-mcp/

# Local dev stack data (native Postgres/Redis/MinIO created by setup; not for git)
.devstack/

# Local demo/scratch media used for testing (not redistributed)
apps/web/public/lableit_demo.jpg

# Temporary files
*.tmp
*.bak
*.old