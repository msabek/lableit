# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific file types to always use LF (Unix-style)
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.env text eol=lf
*.env.* text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Windows-specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (don't modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.pt binary
*.pth binary
*.safetensors binary
*.onnx binary
